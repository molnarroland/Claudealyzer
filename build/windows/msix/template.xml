<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="claudealyzer"
        Arguments=""
        InstallLocation="C:\Program Files\Claudealyzer\Claudealyzer">
    </Installer>
    <PackageInformation
        PackageName="Claudealyzer"
        PackageDisplayName="Claudealyzer"
        PublisherName="CN=Claudealyzer"
        PublisherDisplayName="Claudealyzer"
        Version="0.1.0.0"
        PackageDescription="A claudealyzer application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.claudealyzer.app"
                Description="A claudealyzer application"
                DisplayName="Claudealyzer"
                ExecutableName="claudealyzer"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Claudealyzer</DisplayName>
            <PublisherDisplayName>Claudealyzer</PublisherDisplayName>
            <Description>A claudealyzer application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="claudealyzer.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
